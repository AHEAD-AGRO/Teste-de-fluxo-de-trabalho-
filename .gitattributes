# ==========================================================================
# Normalização de fim de linha — garante que Windows (Renan) e o SO da
# Evelyn gravem os arquivos do mesmo jeito no Git (LF), evitando arquivos
# aparecendo como "modificados" sem ninguém ter mexido.
# ==========================================================================

# Todo arquivo de texto entra no Git com LF
* text=auto eol=lf

# Scripts PowerShell funcionam melhor com CRLF no Windows
*.ps1 text eol=crlf

# Binários nunca são convertidos
*.png binary
*.jpg binary
*.ico binary
