{
  "name": "teste-fluxo-de-trabalho",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Laboratório para validar o fluxo de trabalho compartilhado (merges, ambientes de teste/produção) usando Supabase como backend simulado.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
