# ==========================================================================
# EXEMPLO de variáveis de ambiente.
# Copie este arquivo para ".env" e preencha com as chaves reais.
#   (o .env NÃO vai pro GitHub — está no .gitignore)
# ==========================================================================

# Qual ambiente usar localmente: "test" (teste) ou "production" (produção)
APP_ENV=test

# ---- Ambiente de TESTE (projeto Supabase de teste) ----
TEST_SUPABASE_URL=https://SEU-PROJETO-TESTE.supabase.co
TEST_SUPABASE_ANON_KEY=sua-chave-anon-de-teste

# ---- Ambiente de PRODUÇÃO (projeto Supabase de produção) ----
PROD_SUPABASE_URL=https://SEU-PROJETO-PROD.supabase.co
PROD_SUPABASE_ANON_KEY=sua-chave-anon-de-producao
